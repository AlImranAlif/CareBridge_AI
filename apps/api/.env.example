# Copy to .env for local development. Keep secrets out of source control.
APP_ENV=development
LOG_LEVEL=INFO
# Optional; the demo document workflow uses SQLite on DATA_DIR and needs no database URL.
# DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
# Optional regex for explicitly allowed preview origins; leave unset for local dev.
# CORS_ORIGIN_REGEX=
DATA_DIR=.carebridge-mvp
MAX_UPLOAD_BYTES=10485760
